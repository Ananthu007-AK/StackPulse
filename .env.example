# Server
PORT=6001
NODE_ENV=development
FRONTEND_URL=http://localhost:5178

# Database (Prisma reads this automatically)
DATABASE_URL=postgresql://postgres:password@localhost:5432/stackpulse

# JWT
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# GitHub API
# Generate at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cache
CACHE_TTL_MINUTES=15
