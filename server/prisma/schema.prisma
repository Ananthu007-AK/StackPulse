generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")

  pins        Pin[]
  comparisons Comparison[]

  @@map("users")
}

model Developer {
  id             String   @id @default(cuid())
  githubUsername String   @unique @map("github_username")
  githubId       Int?     @unique @map("github_id")
  avatarUrl      String?  @map("avatar_url")
  name           String?
  bio            String?
  company        String?
  location       String?
  blog           String?
  followers      Int      @default(0)
  following      Int      @default(0)
  publicRepos    Int      @default(0) @map("public_repos")
  etag           String?  @map("etag")
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  repositories Repository[]
  comparisons  ComparisonDeveloper[]

  @@index([fetchedAt])
  @@map("developers")
}

model Repository {
  id              String    @id @default(cuid())
  developerId     String    @map("developer_id")
  githubRepoId    Int       @unique @map("github_repo_id")
  name            String
  fullName        String    @map("full_name")
  description     String?
  htmlUrl         String?   @map("html_url")
  stars           Int       @default(0)
  forks           Int       @default(0)
  primaryLanguage String?   @map("primary_language")
  languages       Json      @default("{}")
  isFork          Boolean   @default(false) @map("is_fork")
  pushedAt        DateTime? @map("pushed_at")
  fetchedAt       DateTime  @default(now()) @map("fetched_at")

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  pins      Pin[]

  @@index([developerId])
  @@index([stars])
  @@map("repositories")
}

model Pin {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  repoId   String   @map("repo_id")
  note     String?
  tags     String[] @default([])
  pinnedAt DateTime @default(now()) @map("pinned_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([userId, repoId])
  @@map("pins")
}

model Comparison {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  developers ComparisonDeveloper[]

  @@map("comparisons")
}

model ComparisonDeveloper {
  id           String @id @default(cuid())
  comparisonId String @map("comparison_id")
  developerId  String @map("developer_id")
  order        Int    @default(0)

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  developer  Developer  @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, developerId])
  @@map("comparison_developers")
}
